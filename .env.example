# HomeHoard configuration — EXAMPLE ONLY.
#
# Copy to .env and edit. Every value here is a placeholder: this file
# contains NO usable secrets and is safe to commit.
#
# Generated by tools/gen_config_docs.py from the settings inventory.
# Do not edit by hand — CI regenerates and diffs it.
#
# Full reference, including security impact: docs/configuration.md

# --- Storage -------------------------------------------------------
# Directory for the SQLite database, attachments and persisted secrets.
#HBOX_DATA_DIR=./data

# Full SQLAlchemy URL. Blank = SQLite inside DATA_DIR. Postgres is
# supported: postgresql+psycopg://user:pass@host:5432/dbname.
# SECRET. Also supported: HBOX_DATABASE_URL_FILE=/run/secrets/... (Docker secrets)
#HBOX_DATABASE_URL=

# One-shot: when DATABASE_URL points at an EMPTY Postgres and a local SQLite
# database exists, copy the SQLite data across at startup before serving.
#HBOX_MIGRATE_FROM_SQLITE=false

# Home Assistant only: discover the Shared PostgreSQL add-on and use a
# database it provisions for HomeHoard. Ignored when DATABASE_URL is set.
#HBOX_USE_SHARED_POSTGRES=false

# Token for the Shared PostgreSQL add-on's provisioning API. Leave blank to
# auto-obtain it via discovery; set it to the add-on's token if discovery
# can't supply it.
# SECRET. Also supported: HBOX_POSTGRES_PROVISION_TOKEN_FILE=/run/secrets/... (Docker secrets)
#HBOX_POSTGRES_PROVISION_TOKEN=

# --- Security ------------------------------------------------------
# JWT signing key. Blank = generated once and persisted in DATA_DIR.
# Deliberately has no add-on option: it must never be minted per boot, which
# would log every user out and void every API token.
# SECRET. Also supported: HBOX_SECRET_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_SECRET_KEY=

# How long an issued token stays valid, in hours.
#HBOX_JWT_HOURS=72

# Bind every request to a single local user. ONLY safe behind an
# authenticating proxy such as Home Assistant ingress.
#HBOX_DISABLE_AUTH=false

# Allow anyone who can reach the app to create an account.
#HBOX_ALLOW_REGISTRATION=true

# Minimum password length enforced on register / change-password.
#HBOX_MIN_PASSWORD_LENGTH=8

# --- Network & proxy -----------------------------------------------
# HTTP port for the app.
#HBOX_PORT=7745

# Comma-separated origins allowed to make credentialed cross-origin
# requests. Empty = same-origin only (correct for normal deployments).
#HBOX_CORS_ORIGINS=

# How many reverse proxies sit in front. 0 = do not trust X-Forwarded-*
# headers at all.
#HBOX_PROXY_HOPS=0

# Enable request rate limiting (disabled automatically under tests).
#HBOX_RATELIMIT_ENABLED=true

# --- AI providers --------------------------------------------------
# Which AI backend to use. Blank disables AI features cleanly. Can also be
# set in the UI, which wins over this value.
#HBOX_AI_PROVIDER=

# Per-request timeout for AI provider calls.
#HBOX_AI_TIMEOUT_SECONDS=60

# Auto-categorization: a proposed label at/above this model-reported
# confidence (and matching an existing label) is applied automatically;
# below it, or a new label, goes to the review queue.
#HBOX_AI_CONFIDENCE_THRESHOLD=0.8

# API key for the claude provider.
# SECRET. Also supported: HBOX_ANTHROPIC_API_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_ANTHROPIC_API_KEY=

# Model for the claude provider.
#HBOX_CLAUDE_MODEL=claude-opus-4-8

# API key for the openai provider.
# SECRET. Also supported: HBOX_OPENAI_API_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_OPENAI_API_KEY=

# Model for the openai provider.
#HBOX_OPENAI_MODEL=gpt-4o-mini

# Override the OpenAI API base URL (for compatible gateways / local SLM
# servers such as LM Studio, vLLM, llama.cpp).
#HBOX_OPENAI_BASE_URL=

# Base URL of the Ollama server.
#HBOX_OLLAMA_URL=http://localhost:11434

# Model for the ollama provider.
#HBOX_OLLAMA_MODEL=llama3.1

# Ollama API key (ollama.com) for the hosted web search, used to enrich
# items with a short searchable description. Blank = enrichment is off.
# SECRET. Also supported: HBOX_OLLAMA_SEARCH_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_OLLAMA_SEARCH_KEY=

# API key for Ollama Cloud (ollama.com), a distinct provider from a local
# Ollama server.
# SECRET. Also supported: HBOX_OLLAMA_CLOUD_API_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_OLLAMA_CLOUD_API_KEY=

# Model for the ollama_cloud provider.
#HBOX_OLLAMA_CLOUD_MODEL=

# --- Barcode identification ----------------------------------------
# Identify a product from a scanned UPC/EAN. Off by default because it makes
# outbound network calls.
#HBOX_BARCODE_LOOKUP=false

# Product barcode database endpoint.
#HBOX_BARCODE_DB_URL=https://api.upcitemdb.com/prod/trial/lookup

# API key for the barcode database. Blank uses the keyless trial tier.
# SECRET. Also supported: HBOX_BARCODE_DB_KEY_FILE=/run/secrets/... (Docker secrets)
#HBOX_BARCODE_DB_KEY=

# --- MCP (Home Assistant Assist) -----------------------------------
# Run the MCP server so Home Assistant Assist can use HomeHoard as a tool.
#HBOX_MCP_ENABLED=true

# Bind address for the MCP server.
#HBOX_MCP_HOST=0.0.0.0

# Port for the MCP server (SSE).
#HBOX_MCP_PORT=7766

# Backend API URL the MCP server calls. Blank = derived from PORT.
#HBOX_MCP_API=

# Token the MCP server uses when app auth is enabled.
# SECRET. Also supported: HBOX_MCP_API_TOKEN_FILE=/run/secrets/... (Docker secrets)
#HBOX_MCP_API_TOKEN=

# Bearer token Home Assistant must present to reach the MCP server. Blank
# leaves it unauthenticated (only safe on a trusted network).
# SECRET. Also supported: HBOX_MCP_SERVER_TOKEN_FILE=/run/secrets/... (Docker secrets)
#HBOX_MCP_SERVER_TOKEN=

# Reach the MCP server from OUTSIDE Home Assistant. When on, every request
# must present a Full- or MCP-scoped API key, and the server refuses to
# start until such a key exists — so it is never open. You must also map the
# MCP port in the add-on's Network tab.
#HBOX_MCP_EXPOSE_EXTERNAL=false

# --- Serving & misc ------------------------------------------------
# Run the in-process background-job worker thread (async AI tooling).
#HBOX_WORKER_ENABLED=true

# Maximum upload size in MB.
#HBOX_MAX_UPLOAD_MB=50

# Path to the built SPA. Blank = the location baked into the image.
#HBOX_FRONTEND_DIST=

# Override the hostname advertised to Home Assistant via Supervisor
# discovery. Blank = ask the Supervisor for the add-on's own hostname.
#HBOX_DISCOVERY_HOST=

# Flask debug mode. NEVER enable in production — it exposes an interactive
# debugger that executes arbitrary code.
#HBOX_DEBUG=false

# --- Logging -------------------------------------------------------
# Application log level. Applies to both the app and gunicorn.
#HBOX_LOG_LEVEL=INFO

# Log a line for any request slower than this many milliseconds. 0 logs
# every request, which fills the log on a busy instance — the gunicorn
# access log already covers the ordinary case.
#HBOX_SLOW_REQUEST_MS=1000

# --- docker-compose only ---------------------------------------
# Host address the MCP port is published on. Not read by the app: it is
# consumed by docker-compose.yml when mapping the port. 127.0.0.1 keeps
# MCP reachable only from this host; 0.0.0.0 exposes it on the LAN, which
# requires HBOX_MCP_SERVER_TOKEN to be set.
#HBOX_MCP_BIND=127.0.0.1
